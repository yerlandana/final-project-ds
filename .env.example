# Скопируйте этот файл в .env и подставьте свой ключ:
#   cp .env.example .env
#
# Без ключа приложение полностью работает - AI-объяснение просто
# формируется офлайн-шаблоном вместо языковой модели.

OPENAI_API_KEY=sk-ваш-ключ-здесь

# Необязательные настройки:
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
